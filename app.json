{
  "expo": {
    "name": "Lockin 2026",
    "slug": "lockin-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lockin.2026",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow LockIn to save focus session cards to your gallery.",
        "NSPhotoLibraryAddUsageDescription": "Allow LockIn to add focus session cards to your gallery.",
        "NSMotionUsageDescription": "Allow LockIn to use motion sensors for the interactive widget.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.devnoname.lockin2026",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-media-library",
      "expo-audio",
      "expo-asset",
      "expo-file-system",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "pcimmortal",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17720551-6a93-413c-a4ff-3fcf52d0f26f"
      }
    }
  }
}